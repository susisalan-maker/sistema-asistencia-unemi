le="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=11;labelBackgroundColor=#FFFFFF;" vertex="1" connectable="0" parent="rel10"><mxGeometry x="-0.72" relative="1" as="geometry"><mxPoint y="-12" as="offset"/></mxGeometry></mxCell><mxCell id="rel10_1" value="0..1" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=11;labelBackgroundColor=#FFFFFF;" vertex="1" connectable="0" parent="rel10"><mxGeometry x="0.72" relative="1" as="geometry"><mxPoint y="-12" as="offset"/></mxGeometry></mxCell><mxCell id="rel11" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;startArrow=ERmandOne;endArrow=ERzeroToOne;startFill=0;endFill=0;startSize=12;endSize=12;strokeColor=#000000;exitX=1.0000;exitY=0.6005;entryX=0.0000;entryY=0.3630;" edge="1" parent="1" source="usuarios" target="rostros"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="rel11_0" value="1..1" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=11;labelBackgroundColor=#FFFFFF;" vertex="1" connectable="0" parent="rel11"><mxGeometry x="-0.62" relative="1" as="geometry"><mxPoint y="-12" as="offset"/></mxGeometry></mxCell><mxCell id="rel11_1" value="0..1" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=11;labelBackgroundColor=#FFFFFF;" vertex="1" connectable="0" parent="rel11"><mxGeometry x="0.62" relative="1" as="geometry"><mxPoint y="-12" as="offset"/></mxGeometry></mxCell><mxCell id="rel12" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;startArrow=ERzeroToOne;endArrow=ERzeroToMany;startFill=0;endFill=0;startSize=12;endSize=12;strokeColor=#000000;exitX=1.0000;exitY=0.3557;entryX=0.0000;entryY=0.5391;" edge="1" parent="1" source="usuarios" target="bitacora"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="rel12_0" value="0..1" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=11;labelBackgroundColor=#FFFFFF;" vertex="1" connectable="0" parent="rel12"><mxGeometry x="-0.92" relative="1" as="geometry"><mxPoint y="-12" as="offset"/></mxGeometry></mxCell><mxCell id="rel12_1" value="0..*" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=11;labelBackgroundColor=#FFFFFF;" vertex="1" connectable="0" parent="rel12"><mxGeometry x="0.92" relative="1" as="geometry"><mxPoint y="-12" as="offset"/></mxGeometry></mxCell><mxCell id="nota" value="&lt;b&gt;Leyenda&lt;/b&gt;&lt;br&gt;PK = clave primaria · FK = clave foránea&lt;br&gt;&lt;br&gt;&lt;b&gt;Auditoría:&lt;/b&gt; sedes, bloques, usuarios y configuracion llevan created_at, created_by, updated_at y updated_by (created_by y updated_by son FK a usuarios.id; sus líneas no se dibujan para no saturar el diagrama).&lt;br&gt;&lt;br&gt;&lt;b&gt;rostros&lt;/b&gt; guarda los vectores faciales CIFRADOS (AES-256-GCM); solo el microservicio accede a esa tabla.&lt;br&gt;&lt;br&gt;marcaciones.(bloque_id, sede_id) es una FK compuesta a bloques: asegura que el bloque pertenezca a la sede de la marcación.&lt;br&gt;&lt;br&gt;bitacora.entidad_id referencia a cualquier tabla (no es FK). dispositivo_id es un identificador externo (no es FK)." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#444444;strokeColor=#999999;dashed=1;rounded=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="1150" y="560" width="280" height="330" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>