@startuml
!include comun.iuml
skinparam componentStyle rectangle
skinparam nodesep 25
skinparam ranksep 45

package "Presentación" {
  node "Teléfono Android\n(React Native + Expo)" as movil {
    component "Pantallas: marcar,\nhistorial, avisos,\njustificar, perfil" as pm
    database "SQLite\n(cola local)" as sqlite
    component "Sincronizador,\nfirma P-256\ny cifrado" as sync
  }
  node "Navegador\n(React + Vite)" as web {
    component "/usuario\ncontingencia" as wu
    component "/admin\nTalento Humano" as wa
  }
}

package "Lógica de negocio (Render)" {
  component "Microservicio FastAPI" as ms {
    component "Verificación\nfacial (ONNX)" as bio
    component "Reglas y\nanomalías" as reglas
    component "Chat de\njustificación" as chat
  }
}

package "Datos (Supabase)" {
  component "Supabase\nAuth" as auth
  database "PostgreSQL\n(RLS, funciones\ny disparadores)" as pg
}

cloud "Proveedor\nde IA" as ia

pm --> sqlite : sin red
sqlite --> sync
sync --> ms : HTTPS
pm --> ms : HTTPS
wu --> ms : HTTPS
wa --> ms : HTTPS
pm ..> pg : lecturas
wa ..> pg : lecturas y RPC
ms --> pg : service_role
ms --> auth : token
chat --> ia : HTTPS
@enduml
