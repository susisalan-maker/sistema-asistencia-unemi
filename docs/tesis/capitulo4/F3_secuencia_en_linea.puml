@startuml
!include comun.iuml
skinparam sequenceMessageAlign left
skinparam maxMessageSize 210
autonumber
actor "Usuario" as U
participant "App\nmóvil" as App
participant "Micro-\nservicio" as MS
participant "Supabase\nAuth" as Auth
database "Postgre-\nSQL" as DB

U -> App : Pulsa «Marcar»\ny toma la selfie
App -> App : Lee ubicación,\nprecisión y marca\nde ubicación simulada
App -> MS : POST /marcaciones\n(id, tipo, lat, lon,\nprecisión, selfie)
MS -> Auth : Valida el token
Auth --> MS : Usuario autenticado
MS -> DB : ¿Existe ya una\nmarcación con ese id?
alt reintento con el mismo id
  MS --> App : 200 (la existente)
else marcación nueva
  MS -> DB : Lee sede, bloques\ny configuración
  MS -> MS : Ubicación simulada,\nteléfono vinculado\ny precisión
  MS -> DB : Lee marcaciones\ndel día
  MS -> MS : Secuencia del día
  MS -> DB : Lee vectores\nfaciales cifrados
  MS -> MS : Similitud y\nprobabilidad de\ncara real
  alt rostro no verificado
    MS -> DB : Anomalía\nverificacion_fallida
    MS --> App : 422
  else rostro verificado
    MS -> MS : Zona (Haversine)
    MS -> DB : Inserta la marcación\n(inmutable)
    MS -> MS : Reglas de\nanomalías
    MS -> DB : Inserta anomalías
    MS --> App : 201
  end
end
App --> U : Resultado y avisos
@enduml
