@startuml
!include comun.iuml
skinparam defaultFontSize 15
hide circle
hide empty members
skinparam linetype ortho
skinparam nodesep 25
skinparam ranksep 40
entity "auth.users" as au {
  * id <<PK>>
}
entity sedes {
  * id <<PK>>
  --
  nombre, latitud, longitud
  radio_metros
  permite_fuera_geocerca
}
entity bloques {
  * id <<PK>>
  --
  sede_id <<FK>>
  latitud, longitud
  radio_metros
}
entity usuarios {
  * id <<PK, FK>>
  --
  sede_id <<FK>>
  nombres, email, rol
  jornada, activo
  dispositivo_id
  clave_publica
}
entity rostros {
  * id <<PK>>
  --
  usuario_id <<FK, UQ>>
  vectores_cifrados
  version_clave
}
entity marcaciones {
  * id <<PK>>
  --
  usuario_id, sede_id <<FK>>
  bloque_id <<FK>>
  tipo, fecha_hora
  latitud, longitud
  precision_m, origen
  verificacion
  sin_conexion, firmada
}
entity anomalias {
  * id <<PK>>
  --
  marcacion_id <<FK>>
  usuario_id <<FK>>
  numero, tipo
  detector, estado
  fecha_vencimiento
}
entity justificaciones {
  * id <<PK>>
  --
  anomalia_id <<FK, UQ>>
  revisado_por <<FK>>
  resumen_ia
  decision_final
  comentario_admin
}
entity mensajes_chat {
  * id <<PK>>
  --
  justificacion_id <<FK>>
  emisor, contenido
}
entity bitacora {
  * id <<PK>>
  --
  usuario_id <<FK>>
  evento, entidad
}
entity configuracion {
  * id <<PK>> (= 1)
  --
  plazos y umbrales
}
entity feriados {
  * id <<PK>>
  --
  fecha_inicio, fecha_fin
}
entity ia_claves {
  * id <<PK>>
  --
  llave_cifrada, activa
}

au ||--o| usuarios
sedes ||--o{ bloques
sedes |o--o{ usuarios
usuarios ||--o| rostros
usuarios ||--o{ marcaciones
sedes ||--o{ marcaciones
bloques |o--o{ marcaciones
marcaciones |o--o{ anomalias
usuarios ||--o{ anomalias
anomalias ||--o| justificaciones
justificaciones ||--o{ mensajes_chat
usuarios |o--o{ bitacora
@enduml
