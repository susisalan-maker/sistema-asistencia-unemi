@startuml
!include comun.iuml
hide empty members
skinparam classAttributeIconSize 0
skinparam nodesep 30
skinparam ranksep 50

package "Modelo de dominio" {
class Sede {
  id: UUID
  nombre: str
  latitud, longitud: float
  radio_metros: int
  permite_fuera_geocerca: bool
  activa: bool
}
class Bloque {
  id: UUID
  nombre: str
  latitud, longitud: float
  radio_metros: int
  activo: bool
}
class Usuario {
  id: UUID
  nombres, apellidos, email: str
  rol: RolUsuario
  jornada_inicio, jornada_fin: time
  dias_laborables: list[int]
  dispositivo_id: str
  clave_publica: str
  fecha_consentimiento_biometrico: datetime
  activo: bool
}
class Rostro {
  vectores_cifrados: bytes
  version_clave: int
}
class Marcacion {
  id: UUID
  tipo: TipoMarcacion
  fecha_hora: datetime
  latitud, longitud: float
  precision_m: float
  origen: OrigenMarcacion
  verificacion: VerificacionRostro
  similitud_score: float
  sin_conexion: bool
  firmada: bool
}
class Anomalia {
  numero: int
  tipo: TipoAnomalia
  detector: DetectorAnomalia
  detalle: str
  estado: EstadoAnomalia
  fecha_vencimiento: datetime
}
class Justificacion {
  resumen_ia: str
  clasificacion_ia: ClasificacionJustificacion
  decision_final: DecisionCaso
  comentario_admin: str
  fecha_decision: datetime
}
class MensajeChat {
  emisor: EmisorMensaje
  contenido: str
}
class Bitacora {
  evento: EventoBitacora
  entidad, entidad_id: str
  valor_anterior, valor_nuevo: str
}
class Configuracion {
  tolerancia_min: int
  almuerzo_max_min: int
  velocidad_max_kmh: int
  max_marcaciones_web_30d: int
  rostro_umbral, vida_umbral: float
  precision_max_app_m, precision_max_web_m: int
}
class Feriado {
  fecha_inicio, fecha_fin: date
  nombre: str
}
}

package "Servicios del microservicio" {
interface Verificador <<Protocol>> {
  +verificar(usuario, selfie_b64, criterios): ResultadoVerificacion
}
class VerificadorFacial {
  +verificar(...)
}
class VerificadorSimulado {
  +verificar(...)
}
class MotorFacial {
  +analizar(foto_b64, max_giro, criterios): Analisis
  +probabilidad_real(img, caja): float
}
class SupabaseClient {
  +usuario_de_token(token)
  +insertar_marcacion(datos)
  +insertar_anomalia(datos)
  +bloques_activos_de_sede(sede_id)
  +registrar_rostro(...)
}
}

Sede "1" *-- "0..*" Bloque
Sede "1" -- "0..*" Usuario : pertenece >
Usuario "1" *-- "0..1" Rostro
Usuario "1" -- "0..*" Marcacion : registra >
Sede "1" -- "0..*" Marcacion
Bloque "0..1" -- "0..*" Marcacion
Marcacion "0..1" -- "0..*" Anomalia : origina >
Usuario "1" -- "0..*" Anomalia
Anomalia "1" -- "0..1" Justificacion
Justificacion "1" *-- "0..*" MensajeChat
Usuario "0..1" -- "0..*" Bitacora : actúa >

Verificador <|.. VerificadorFacial
Verificador <|.. VerificadorSimulado
VerificadorFacial --> MotorFacial
VerificadorFacial --> SupabaseClient
VerificadorFacial ..> Rostro : descifra
@enduml
