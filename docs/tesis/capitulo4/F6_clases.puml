@startuml
!include comun.iuml
skinparam defaultFontSize 15
hide empty members
hide circle
skinparam classAttributeIconSize 0
skinparam nodesep 20
skinparam ranksep 40

package "Dominio" {
class Sede {
  nombre
  latitud, longitud
  radio_metros
  permite_fuera_geocerca
}
class Bloque {
  nombre
  latitud, longitud
  radio_metros
}
class Usuario {
  rol
  jornada, días laborables
  dispositivo_id
  clave_publica
  consentimiento
}
class Rostro {
  vectores_cifrados
}
class Marcacion {
  tipo, fecha_hora
  latitud, longitud
  precision_m, origen
  verificacion
  sin_conexion, firmada
}
class Anomalia {
  tipo, detector
  estado
  fecha_vencimiento
}
class Justificacion {
  resumen_ia
  decision_final
  comentario_admin
}
class MensajeChat {
  emisor, contenido
}
class Bitacora {
  evento, entidad
  valor anterior y nuevo
}
}

package "Servicios" {
interface Verificador <<Protocol>> {
  +verificar()
}
class VerificadorFacial
class VerificadorSimulado
class MotorFacial {
  +analizar()
  +probabilidad_real()
}
class SupabaseClient
}

Sede "1" -- "0..*" Bloque
Sede "1" -- "0..*" Usuario
Usuario "1" *-- "0..1" Rostro
Usuario "1" -- "0..*" Marcacion
Sede "1" -- "0..*" Marcacion
Bloque "0..1" -- "0..*" Marcacion
Marcacion "0..1" -- "0..*" Anomalia
Usuario "1" -- "0..*" Anomalia
Anomalia "1" -- "0..1" Justificacion
Justificacion "1" -- "0..*" MensajeChat
Usuario "0..1" -- "0..*" Bitacora

Verificador <|.. VerificadorFacial
Verificador <|.. VerificadorSimulado
VerificadorFacial --> MotorFacial
VerificadorFacial --> SupabaseClient
VerificadorFacial ..> Rostro : descifra
@enduml
