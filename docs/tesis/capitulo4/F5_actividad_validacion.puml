@startuml
!include comun.iuml
skinparam padding 1
skinparam defaultFontSize 15
|App o web|
start
:Capturar selfie,\nubicación y precisión;
|Microservicio|
if (¿Id ya\nregistrado?) then (sí)
  :Devolver la\nexistente;
  stop
elseif (¿Ubicación\nsimulada?) then (sí)
  :Anomalía y\nrechazo (403);
  stop
elseif (¿Otro\nteléfono?) then (sí)
  :Rechazo\n(403);
  stop
else (no)
endif
if (¿Sin\nconexión?) then (no)
  if (¿Precisión\nsobre el límite?) then (sí)
    :Pedir mejor\nseñal;
    stop
  else (no)
  endif
else (sí)
  if (¿Reloj, firma\ny orden válidos?) then (no)
    :Rechazo sin\nregistrar;
    stop
  else (sí)
  endif
endif
if (¿Sigue la\nsecuencia?) then (no)
  :Anomalía y\nrechazo;
  stop
else (sí)
endif
if (¿Rostro y vivacidad\nverificados?) then (no)
  if (¿Sin\nconexión?) then (sí)
    :Seguir con\nverificación\npendiente;
  else (no)
    :Anomalía y\nnueva foto (422);
    stop
  endif
else (sí)
endif
:Zona (Haversine)\ny reglas de anomalías;
|PostgreSQL|
:Insertar marcación\ny anomalías;
|App o web|
:Mostrar resultado\ny avisos;
stop
@enduml
