# Copia este archivo a .env (nunca se sube a git) y completa los valores.
SUPABASE_URL=https://<tu-proyecto>.supabase.co
# La service_role key SOLO vive aquí. Jamás en panel-web ni en app-movil.
SUPABASE_SERVICE_ROLE_KEY=
# URL del panel web a la que apuntan los enlaces de los correos (invitación y restablecer contraseña).
URL_PANEL_WEB=http://localhost:5173
# Orígenes que pueden llamar a este servicio (separados por coma).
CORS_ORIGINS=http://localhost:5173

# ---- Verificación facial ----
# "real" registra y compara rostros de verdad (predeterminado). "simulada": toda marcación pasa; solo para desarrollo.
VERIFICACION_FACIAL=real
# Clave AES-256 que cifra los vectores faciales: 64 caracteres hexadecimales. SOLO vive en el servidor (Render: variable
# de entorno). Si la pierdes, nadie puede ser verificado y todos deben registrar su rostro de nuevo: respáldala aparte.
# Generar:  python -c "import secrets; print(secrets.token_hex(32))"
ROSTRO_CLAVE_AES=
# Los umbrales del reconocimiento (parecido, vida, giro, luz, nitidez, tamaños) se editan en el panel: Configuración →
# Reconocimiento facial. Se guardan en la base y se aplican sin reiniciar. Estos tres solo sirven de respaldo si la base
# no los trae (por ejemplo, sin la migración 0009); lo que diga el panel manda.
ROSTRO_UMBRAL=0.40
ROSTRO_UMBRAL_REGISTRO=0.35
# Detección de vida pasiva (¿foto o pantalla?). VIDA_ACTIVA enciende o apaga la detección (decide qué modelos se cargan al
# arrancar). VIDA_UMBRAL es el respaldo del valor del panel.
VIDA_ACTIVA=true
VIDA_UMBRAL=0.5

# ---- Firma de las marcaciones sin conexión (clave del chip de seguridad del celular) ----
# Con una clave registrada, la firma de cada marcación sin conexión es siempre obligatoria. En true lo es también para quien
# aún no registró clave (por ejemplo, quien usa Expo Go): actívalo cuando todos usen la app compilada (APK / iOS).
FIRMA_OBLIGATORIA=false
# En true, al registrar una clave de Android se exige la prueba de que vive en el hardware (TEE o StrongBox).
FIRMA_EXIGE_HARDWARE=false
# Huellas SHA-256 (hex, separadas por comas) de las raíces de Google aceptadas para esa prueba. Vacío = no se ancla la raíz.
ATESTACION_RAICES_SHA256=

# ---- Proceso periódico de ausencias (sin_ingreso / sin_salida / sin_regreso_almuerzo) ----
# Secreto que autoriza a quien llama a POST /procesos/ausencias (cabecera X-Proceso-Secreto). Vacío = endpoint apagado (503).
# Generar:  python -c "import secrets; print(secrets.token_hex(32))"
PROCESOS_SECRETO=
# Minutos después de jornada_fin antes de dar el día por terminado (por si alguien marca la salida un rato tarde).
AUSENCIAS_GRACIA_MIN=120
# Cuántos días hacia atrás revisa en cada corrida (recupera días si el proceso estuvo caído).
AUSENCIAS_DIAS_ATRAS=3

# ---- Chat de justificación con IA (opcional) ----
# Las claves de IA (proveedor, modelo y llave) se guardan en el panel: Configuración → Inteligencia artificial. Una sola está activa.
# La llave del panel se guarda CIFRADA con ROSTRO_CLAVE_AES (tabla ia_claves) y la clave activa tiene prioridad sobre este archivo.
# Las variables de abajo sirven de respaldo: la llave si no hay una en el panel, y IA_PROVEEDOR / IA_MODELO solo si no hay
# ninguna clave activa en el panel. Las llaves nunca van en la app, el panel (en claro) ni git.
# Sin llave en ninguno de los dos sitios el chat funciona sin IA: un mensaje y el caso pasa directo a Talento Humano.
IA_PROVEEDOR=gemini
# Gemini: crea la llave en https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Anthropic: console.anthropic.com → API keys. Pon un tope de gasto mensual en la consola.
ANTHROPIC_API_KEY=
# OpenAI: platform.openai.com → API keys.
OPENAI_API_KEY=
# Modelo. Vacío = el recomendado del proveedor (gemini-flash-latest, claude-haiku-5-5 o gpt-4.1-mini). Si quieres otro, escribe su id exacto.
IA_MODELO=
# Límites del chat (ver docs/logica-negocio.md, sección 6): mensajes de la persona por caso y preguntas del asistente.
IA_MAX_MENSAJES_USUARIO=3
IA_MAX_PREGUNTAS=1
# Aprobación automática, APAGADA por omisión: la IA solo conversa, resume y sugiere una etiqueta; una persona aprueba o rechaza.
# Con IA_AUTOAPROBAR=true aprobaría sola solo faltas de menor riesgo con clasificación «aceptable» y la confianza mínima de abajo (0 a 1).
IA_AUTOAPROBAR=false
IA_UMBRAL_AUTOAPROBAR=0.9
