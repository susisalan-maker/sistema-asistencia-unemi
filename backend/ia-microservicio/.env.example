# Copia este archivo a .env (nunca se sube a git) y completa los valores.
SUPABASE_URL=https://<tu-proyecto>.supabase.co
# La service_role key SOLO vive aquí. Jamás en panel-web ni en app-movil.
SUPABASE_SERVICE_ROLE_KEY=
# URL del panel web a la que apuntan los enlaces de los correos (invitación y restablecer contraseña).
URL_PANEL_WEB=http://localhost:5173
# Orígenes que pueden llamar a este servicio (separados por coma).
CORS_ORIGINS=http://localhost:5173

# ---- Verificación facial ----
# "real" registra y compara rostros de verdad (predeterminado). "simulada": toda marcación pasa; solo para desarrollo.
VERIFICACION_FACIAL=real
# Clave AES-256 que cifra los vectores faciales: 64 caracteres hexadecimales. SOLO vive en el servidor (Render: variable
# de entorno). Si la pierdes, nadie puede ser verificado y todos deben registrar su rostro de nuevo: respáldala aparte.
# Generar:  python -c "import secrets; print(secrets.token_hex(32))"
ROSTRO_CLAVE_AES=
# Similitud mínima (0 a 1) para aceptar una selfie. Se calibra con datos reales (ver README).
ROSTRO_UMBRAL=0.40
ROSTRO_UMBRAL_REGISTRO=0.35
# Detección de vida pasiva (¿foto o pantalla?). VIDA_UMBRAL = probabilidad mínima de «rostro real» (0 a 1).
VIDA_ACTIVA=true
VIDA_UMBRAL=0.5

# ---- Proceso periódico de ausencias (sin_ingreso / sin_salida / sin_regreso_almuerzo) ----
# Secreto que autoriza a quien llama a POST /procesos/ausencias (cabecera X-Proceso-Secreto). Vacío = endpoint apagado (503).
# Generar:  python -c "import secrets; print(secrets.token_hex(32))"
PROCESOS_SECRETO=
# Minutos después de jornada_fin antes de dar el día por terminado (por si alguien marca la salida un rato tarde).
AUSENCIAS_GRACIA_MIN=120
# Cuántos días hacia atrás revisa en cada corrida (recupera días si el proceso estuvo caído).
AUSENCIAS_DIAS_ATRAS=3

# ---- Chat de justificación con IA (opcional) ----
# Proveedor: anthropic (Claude) o gemini (Google). Pon SOLO la llave del que elijas. Las llaves viven únicamente aquí:
# nunca en la app, el panel ni git. Sin llave el chat funciona sin IA: un mensaje y el caso pasa directo a Talento Humano.
IA_PROVEEDOR=gemini
# Gemini: crea la llave en https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Anthropic: console.anthropic.com → API keys. Pon un tope de gasto mensual en la consola.
ANTHROPIC_API_KEY=
# Modelo. Vacío = el de por omisión (gemini-flash-latest o claude-haiku-5-5). Si quieres otro, escribe su id exacto.
IA_MODELO=
# Límites del chat (ver docs/logica-negocio.md, sección 6): mensajes de la persona por caso y preguntas del asistente.
IA_MAX_MENSAJES_USUARIO=3
IA_MAX_PREGUNTAS=1
# Aprobación automática: solo faltas de menor riesgo con clasificación «aceptable» y esta confianza mínima (0 a 1).
# IA_AUTOAPROBAR=false la apaga: todo caso llega a una persona.
IA_AUTOAPROBAR=true
IA_UMBRAL_AUTOAPROBAR=0.9
