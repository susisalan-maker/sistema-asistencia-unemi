# Copia este archivo como .env.local y completa los valores (el .env.local NO se sube a Git).
# Son valores públicos: la URL del proyecto y la clave pública (publishable/anon) de Supabase.
EXPO_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# URL del panel web, para el enlace del correo de «Olvidé mi contraseña».
# En desarrollo usa la IP de tu computador (el celular no entiende "localhost"); en producción, la URL de Vercel.
EXPO_PUBLIC_WEB_URL=http://localhost:5173
